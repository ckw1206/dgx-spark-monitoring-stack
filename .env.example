# Prometheus
PROMETHEUS_MEMORY_LIMIT=4g
PROMETHEUS_DATA_DIR=/data/prometheus_data

# DGX Spark
DGX_HOST=192.168.1.100           # IP of the DGX Spark host; change as needed
DGX_COLLECTOR_PORT=9273          # dgx_collector.py metrics port
DGX_SGLANG_PORT=8888             # SGLang/model serving metrics port

# Grafana
GRAFANA_VERSION=latest
GRAFANA_MEMORY_LIMIT=4g
GRAFANA_DATA_DIR=/data/grafana_data
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
